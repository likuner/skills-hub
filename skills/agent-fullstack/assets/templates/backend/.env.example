# 模型接入（OpenAI 兼容协议；换 provider 只改这三行）
# 智谱 GLM（默认）: https://open.bigmodel.cn/api/paas/v4 + glm-5.3-flash（旗舰 glm-5.3）
# DeepSeek:         https://api.deepseek.com/v1 + deepseek-chat
# 通义千问:          https://dashscope.aliyuncs.com/compatible-mode/v1 + qwen-plus
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_API_KEY=
OPENAI_MODEL=glm-5.3-flash

# 数据库（开发用本地 sqlite；生产换 postgresql+asyncpg://user:pass@host/db）
DATABASE_URL=sqlite+aiosqlite:///./{{PROJECT_NAME}}.db

# CORS 白名单（逗号分隔）；开发期前端在 5173，/api 由 Vite 代理转发
CORS_ORIGINS=http://localhost:5173
